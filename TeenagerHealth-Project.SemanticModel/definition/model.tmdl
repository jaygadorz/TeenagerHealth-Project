model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup source

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Source","envID","tbl-Name","columnConfig","stagingTBL","genderDIM","platformDIM","socInteractionDIM"]

annotation PBI_ProTooling = ["DevMode"]

ref table stagingTBL
ref table genderDIM
ref table platformDIM
ref table socInteractionDIM
ref table Measure
ref table 'Demo - Measures'
ref table 'Demo - Columns'

ref role TikTok

ref cultureInfo en-US

