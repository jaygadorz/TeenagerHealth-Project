table Measure
	lineageTag: 7e0f68de-5723-44e7-ac27-da13a0fc8741

	measure 'ave daily social media hours' = ```
			
			
			 CALCULATE(
			    AVERAGEX(
			            stagingTBL,
			            stagingTBL[adminpub_dailysocialmediahours]
			    
			 ))
			```
		formatString: 0
