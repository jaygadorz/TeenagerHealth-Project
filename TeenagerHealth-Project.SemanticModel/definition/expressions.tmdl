expression columnConfig = ```
		let
		    Source = CommonDataService.Database(envID),
		    Filtered = Table.SelectRows(Source, each ([Name] = #"tbl-Name")),
		
		    Expanded = 
		        Table.ExpandTableColumn(Filtered,
		        "Data",
		        Table.ColumnNames(Filtered{0}[Data])
		        ),
		    
		    Top1 = 
		        Table.FirstN(Expanded, 1),
		
		    Headers = 
		        Table.ColumnNames(Top1),
		
		    TableView = Table.FromList(Headers, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
		
		    FilteredInitial = Table.SelectRows(TableView, each ([Column1] = 
		    "adminpub_academicperformance" or [Column1] = "adminpub_addictionlevel" or [Column1] = "adminpub_age" or 
		    [Column1] = "adminpub_anxietylevel" or [Column1] = "adminpub_dailysocialmediahours" or [Column1] = "adminpub_depressionlabel2" or 
		    [Column1] = "adminpub_gender" or [Column1] = "adminpub_physicalactivity" or [Column1] = "adminpub_platformusage" or 
		    [Column1] = "adminpub_screentimebeforesleep" or [Column1] = "adminpub_sleephours" or [Column1] = "adminpub_socialinteractionlevel" or [Column1] = "adminpub_stresslevel")),
		
		
		    ListView = FilteredInitial[Column1]
		
		in
		   ListView
		```
